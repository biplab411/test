{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "node16",
    "target": "ES2021",

    "rootDir": "./src",
    "outDir": "./dist",

    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "strict": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "dist", "test"]
}